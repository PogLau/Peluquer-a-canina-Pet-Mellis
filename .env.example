# Copiá este archivo como .env y completá los valores. Nunca subas .env al repositorio.

# Base de datos: SQLite para la demo local (Postgres si se despliega)
DATABASE_URI=file:./petmellis.db

# Cadena larga y aleatoria. Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Usuario de la peluquera para la demo (lo crea `pnpm seed`)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# WhatsApp del local, formato internacional sin + ni espacios
WHATSAPP_LOCAL=549XXXXXXXXXX

# Opcional: «Sugerir con foto (beta)». Solo se usa del lado del servidor.
GEMINI_API_KEY=
GEMINI_MODEL=
